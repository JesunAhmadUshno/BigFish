# Environment Variables for BigFish
# Copy this to .env.local and fill in your API keys

# NOTE: the site is a static export, so every NEXT_PUBLIC_ key below is baked into
# the public JS bundle. Set them only for local or private builds; the live calls
# are skipped when a key is unset.

# The Odds API — Live betting odds (https://the-odds-api.com)
# Free tier: 500 requests/month
NEXT_PUBLIC_ODDS_API_KEY=your_odds_api_key_here

# API-Sports — live fixtures, stats and match widgets (https://api-sports.io)
NEXT_PUBLIC_API_SPORTS_KEY=your_api_sports_key_here

# Football-Data.org — Match fixtures & standings (https://football-data.org)
# Free tier with registration
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# Open-Meteo — Weather data (https://open-meteo.com)
# Free, no API key required

# TheSportsDB — historical results for the backtester (https://www.thesportsdb.com)
# Optional; the app falls back to the public free-tier key "3"
NEXT_PUBLIC_THESPORTSDB_KEY=your_thesportsdb_key_here
